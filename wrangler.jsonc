{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agentic.jaredwray.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
